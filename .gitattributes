# The downloaded scientific source is hashed byte-for-byte, including newlines.
/examples/public_case/source/*.cif -text
# Prepared artifacts have reproducible LF bytes and hashes on every platform.
/examples/public_case/*.cif text eol=lf
/examples/public_case/*.json text eol=lf
# Browser build inputs and generated resources must agree across build hosts.
/frontend/** text eol=lf
/src/slab_preflight/web_assets/** text eol=lf

# Preserve upstream license text and generated shader string whitespace.
/frontend/public/THIRD_PARTY_LICENSES.txt -whitespace
/src/slab_preflight/web_assets/** -whitespace
